<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
      SSDP discovery answers by multicast, and Android drops it before it
      reaches userspace unless a MulticastLock is held. Without this the app
      finds no players at all, on a network full of them, with nothing in the
      log to explain why. See CardService.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      The card server has to be listening when somebody picks up their phone in
      another room — which is most of the time, on a device whose screen is off.
      A background service holding a socket is stopped without warning.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      connectedDevice, not dataSync. The service exists to talk to speakers on
      the LAN, which is what this type is for — and dataSync carries a six-hour
      daily cap from Android 15 that would stop the card server on a device that
      is, by design, never turned off.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The card leaves the app as a content:// URI: an image cannot be put
          into a share sheet as raw bytes.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shares"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".CardService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
