<?xml version="1.0" encoding="utf-8"?>
<!--
  The card itself: a sleeve on the left, a music note on the right.

  It was three lines of text, standing for the title, the artist and the blurb.
  Nobody read them as anything — at launcher size they are three grey dashes —
  so the note says "music" where they said nothing.

  A vector rather than the usual stack of five PNG densities, because it is a
  shape made of rectangles and there is nothing a rasteriser would do better.
  It also keeps the APK free of binary assets that cannot be reviewed in a diff.

  Adaptive-icon geometry: the 108dp canvas is masked to a 72dp circle-ish shape
  by the launcher, so everything meaningful stays inside the middle 66dp — the
  drawing below spans 27..81, which leaves the corners to be cropped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The sleeve -->
    <path
        android:fillColor="#D4A017"
        android:pathData="M30,38 L54,38 A3,3 0 0 1 57,41 L57,67 A3,3 0 0 1 54,70 L30,70 A3,3 0 0 1 27,67 L27,41 A3,3 0 0 1 30,38 Z" />
    <!-- The label, so the sleeve reads as a record rather than a blank square -->
    <path
        android:fillColor="#16191D"
        android:pathData="M42,50 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />

    <!--
      The note. THESE NUMBERS ARE tools/make-icons.py's NUMBERS: that script
      draws the PNGs iOS needs from the same geometry, and the two only stay
      one icon for as long as both are changed together.
    -->
    <!-- Head -->
    <path
        android:fillColor="#E8EDF2"
        android:pathData="M66.5,64.5 m-6.5,0 a6.5,5.2 0 1,0 13,0 a6.5,5.2 0 1,0 -13,0" />
    <!-- Stem -->
    <path
        android:fillColor="#E8EDF2"
        android:pathData="M71,40.75 A1.75,1.75 0 0 1 74.5,40.75 L74.5,63.25 A1.75,1.75 0 0 1 71,63.25 Z" />
    <!-- Flag -->
    <path
        android:fillColor="#E8EDF2"
        android:pathData="M74.5,39 C79.5,42 81,47.5 78.5,53 C80,47.5 78,44.5 74.5,45.5 Z" />
</vector>
