<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the -v26 variant exists, and that is complete rather than a gap: minSdk
  is 26, so every device this installs on supports adaptive icons and there is
  no older launcher left to fall back for.

  TWO BITMAPS RATHER THAN A VECTOR AND A COLOUR. The icon used to be a shape
  made of rounded rectangles and ellipses, which a vector holds exactly and a
  flat colour sat behind. It is now an SVG with gradients, a drop shadow and a
  glow — an Android vector holds none of those.

  BOTH LAYERS ARE GENERATED BY tools/make-icons.py FROM tools/icon/source.svg.
  The foreground is the artwork with nothing behind it: genuinely transparent
  around the edges, so a launcher may slide the layers against each other for
  parallax without a rectangle appearing. It is sized by the artwork's RADIUS
  from its own centre rather than by a bounding box, because a mask is as often
  a circle as a square and a box around arcs in one corner and a sleeve in the
  other is far bigger than the artwork really is. The background is the SVG's
  own backdrop, squared off and carried to every edge.

  Do not replace one without re-running the script for the other.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
